{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai2593-analysis-content-v1",
  "type": "object",
  "required": ["executive_summary", "themes", "risks", "experiments", "followups"],
  "additionalProperties": false,
  "properties": {
    "executive_summary": {"type": "string", "minLength": 1},
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "title", "summary", "why_it_matters", "evidence_event_ids", "confidence", "owner", "next_action"],
        "additionalProperties": false,
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "why_it_matters": {"type": "string", "minLength": 1},
          "evidence_event_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "owner": {"type": "string", "enum": ["Liu", "LU", "unassigned"]},
          "next_action": {"type": "string"}
        }
      }
    },
    "risks": {"type": "array", "items": {"type": "string"}},
    "experiments": {"type": "array", "items": {"type": "string"}},
    "followups": {"type": "array", "items": {"type": "string"}}
  }
}
